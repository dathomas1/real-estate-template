---
import { Link, Notification } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

/**
 * Hero Component
 *
 * @description A component that displays a hero section with a title, description, and image
 */
interface Props {
  /**
   * The source URL for the image
   */
  src?: string
  /**
   * Additional classes to apply to the ResponsiveToggle
   */
  class?: string
}

const { src = '/astronaut-hero-img.webp', class: className }: Props = Astro.props
---

<section class:list={["hero", "py-24", className]}>
  <div class="container">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-3">
      <div class="col-span-2 flex flex-col items-center gap-8 md:items-start">
        <h1 class="text-center text-5xl md:text-left lg:text-7xl">Your Trusted Real Estate Agent in <span class="text-gradient">Sebring, Florida</span></h1>

        <p class="text-center text-2xl md:text-left">
          Whether you're selling your home for top dollar or finding your Florida dream property, Alyson Thomas delivers neighborhood-level expertise, dedicated personal service, and proven results throughout Sebring and Highlands County.
        </p>
        <div class="flex flex-col gap-3 min-[500px]:flex-row">
          <Link
            href="https://github.com/incluud/accessible-astro-starter"
            isButton
            type="secondary"
            animateOnHover
            animationType="boop"
          >
            Get Your Free Home Valuation
          </Link>
          <Link
            href="tel:+17223428085"
            isButton
            type="primary"
            animateOnHover
            animationType="boop"
          >
            <Icon aria-hidden="true" name="lucide:phone" size="1.5rem" />
            Call (772) 342-8085
          </Link>
        </div>
      </div>
      <Image class="hidden lg:block" src={src} alt="" decoding="async" width={800} height={600} loading="eager" />
    </div>
  </div>
</section>

<style lang="scss">
  h1 {
    text-wrap: unset;
  }

  .text-gradient {
    background: linear-gradient(
      315deg,
      light-dark(var(--color-primary-300), var(--color-secondary-100)) 25%,
      light-dark(var(--color-secondary-300), var(--color-primary-200))
    );
    background-clip: border-box;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
